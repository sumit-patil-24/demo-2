# Used by docker-compose.yml.  Copy to .env and edit:  cp .env.example .env
# Use URL-safe characters in POSTGRES_PASSWORD (letters, digits, - _ .) because it is embedded in DATABASE_URL.

# --- API ---
PORT=5000
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated frontend origins allowed by CORS (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL (DATABASE_URL is assembled by docker-compose from these) ---
POSTGRES_USER=localbizhub
POSTGRES_PASSWORD=
POSTGRES_DB=localbizhub
DB_HOST_PORT=5432
# For reference / running the API outside Docker:
# DATABASE_URL=postgresql://localbizhub:<password>@localhost:5432/localbizhub?schema=public

# --- First admin account (created on startup if not present) ---
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@localbizhub.example
ADMIN_PASSWORD=

# --- Sample data: categories always seeded; true adds demo businesses/products/logins ---
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=Demo@12345
