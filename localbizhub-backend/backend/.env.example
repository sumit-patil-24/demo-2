# Backend config for running WITHOUT Docker (npm run dev in backend/).
# With docker compose, use the .env in the repo root instead.
NODE_ENV=development
PORT=5000

# PostgreSQL connection string (Prisma format)
DATABASE_URL=postgresql://localbizhub:localbizhub@localhost:5432/localbizhub?schema=public

# Long random string, 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Seed data (prisma/seed.js). Admin is created only if both are set.
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@localbizhub.example
ADMIN_PASSWORD=ChangeMe_123!
# true = also create sample categories, businesses, products and demo logins
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=Demo@12345
