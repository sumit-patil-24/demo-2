# Copy to .env:  cp .env.example .env   (.env is git-ignored; never commit it)
# Use URL-safe characters in POSTGRES_PASSWORD (letters, digits, - _ .) because it is embedded in DATABASE_URL.

# --- Public entry point (Nginx) ---
HTTP_PORT=8080
# Public URL(s) of the site, comma-separated. Production example: http://<EC2-public-IP>
CORS_ORIGIN=http://localhost:8080

# --- API ---
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- PostgreSQL (DATABASE_URL is assembled by docker compose from these) ---
POSTGRES_USER=localbizhub
POSTGRES_PASSWORD=
POSTGRES_DB=localbizhub

# --- First admin account (created on startup if it does not exist) ---
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@localbizhub.example
ADMIN_PASSWORD=

# --- Sample data: categories are always seeded; true also adds demo businesses/products/logins ---
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=Demo@12345
